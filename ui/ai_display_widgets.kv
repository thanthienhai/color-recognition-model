#:kivy 2.1.0

# Custom widgets for AI Color Analysis Display

<ColorComponentBar>:
    orientation: 'horizontal'
    size_hint_y: None
    height: 35
    padding: 5
    spacing: 10
    
    canvas.before:
        Color:
            rgba: 0.95, 0.95, 0.95, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [3,]
    
    Label:
        text: root.color_name
        font_size: '14sp'
        size_hint_x: 0.3
        color: 0.2, 0.2, 0.2, 1
        halign: 'left'
        text_size: self.size
    
    ProgressBar:
        max: 100
        value: root.percentage
        size_hint_x: 0.5
        
    Label:
        text: f'{root.percentage:.1f}%'
        font_size: '14sp'
        bold: True
        size_hint_x: 0.2
        color: 0.1, 0.6, 0.1, 1
        halign: 'right'
        text_size: self.size

<MixingFormulaCard>:
    orientation: 'vertical'
    size_hint_y: None
    height: 40
    padding: 8
    spacing: 3
    
    canvas.before:
        Color:
            rgba: root.bg_color[0], root.bg_color[1], root.bg_color[2], 0.8
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [8,]
        Color:
            rgba: 0.3, 0.3, 0.3, 0.3
        Line:
            rounded_rectangle: [self.x, self.y, self.width, self.height, 8]
            width: 1
    
    BoxLayout:
        orientation: 'horizontal'
        
        # Color indicator circle
        Widget:
            size_hint_x: None
            width: 25
            canvas:
                Color:
                    rgba: root.color_rgb[0]/255.0, root.color_rgb[1]/255.0, root.color_rgb[2]/255.0, 1
                Ellipse:
                    pos: self.x + 5, self.y + self.height/2 - 8
                    size: 16, 16
                Color:
                    rgba: 0, 0, 0, 0.5
                Line:
                    ellipse: [self.x + 5, self.y + self.height/2 - 8, 16, 16]
                    width: 1
        
        Label:
            text: root.color_name
            font_size: '15sp'
            bold: True
            size_hint_x: 0.6
            color: 0.1, 0.1, 0.1, 1
            halign: 'left'
            text_size: self.size
        
        Label:
            text: f'{root.percentage:.1f}%'
            font_size: '16sp'
            bold: True
            size_hint_x: 0.3
            color: 0.2, 0.5, 0.8, 1
            halign: 'right'
            text_size: self.size

<AIAnalysisPanel>:
    orientation: 'vertical'
    padding: 15
    spacing: 10
    
    canvas.before:
        Color:
            rgba: 0.98, 0.98, 1.0, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10,]
        Color:
            rgba: 0.7, 0.8, 0.9, 0.8
        Line:
            rounded_rectangle: [self.x, self.y, self.width, self.height, 10]
            width: 2
    
    # Header
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: 40
        
        Label:
            text: '🤖 AI PHÂN TÍCH MÀU'
            font_size: '18sp'
            bold: True
            size_hint_x: 0.7
            color: 0.1, 0.4, 0.7, 1
            halign: 'left'
            text_size: self.size
        
        Label:
            id: confidence_label
            text: 'Độ tin cậy: --'
            font_size: '14sp'
            bold: True
            size_hint_x: 0.3
            color: 0.2, 0.6, 0.2, 1
            halign: 'right'
            text_size: self.size
    
    # Dominant color display
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: 50
        padding: 5
        spacing: 10
        
        canvas.before:
            Color:
                rgba: 0.9, 0.95, 1.0, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [8,]
        
        Widget:
            size_hint_x: None
            width: 40
            id: dominant_color_preview
            canvas:
                Color:
                    rgba: 0.5, 0.5, 0.5, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [5,]
                Color:
                    rgba: 0, 0, 0, 0.3
                Line:
                    rounded_rectangle: [self.x, self.y, self.width, self.height, 5]
                    width: 2
        
        BoxLayout:
            orientation: 'vertical'
            
            Label:
                id: dominant_color_label
                text: 'Màu chính: --'
                font_size: '16sp'
                bold: True
                color: 0.1, 0.1, 0.1, 1
                halign: 'left'
                text_size: self.size
            
            Label:
                id: dominant_percentage_label
                text: 'Tỉ lệ: --%'
                font_size: '14sp'
                color: 0.3, 0.3, 0.3, 1
                halign: 'left'
                text_size: self.size
    
    # Separator
    Widget:
        size_hint_y: None
        height: 2
        canvas:
            Color:
                rgba: 0.8, 0.8, 0.8, 1
            Rectangle:
                pos: self.x + 20, self.y
                size: self.width - 40, 1
    
    # Color components section
    Label:
        text: '🎨 THÀNH PHẦN MÀU:'
        font_size: '16sp'
        bold: True
        size_hint_y: None
        height: 30
        color: 0.2, 0.5, 0.8, 1
        halign: 'left'
        text_size: self.size
    
    ScrollView:
        id: color_components_scroll
        size_hint_y: 0.6
        
        BoxLayout:
            id: color_components_list
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: 3
    
    # Separator
    Widget:
        size_hint_y: None
        height: 2
        canvas:
            Color:
                rgba: 0.8, 0.8, 0.8, 1
            Rectangle:
                pos: self.x + 20, self.y
                size: self.width - 40, 1
    
    # Mixing formula section
    Label:
        text: '🔬 CÔNG THỨC PHA TRỘN:'
        font_size: '16sp'
        bold: True
        size_hint_y: None
        height: 30
        color: 0.8, 0.4, 0.2, 1
        halign: 'left'
        text_size: self.size
    
    ScrollView:
        id: mixing_formula_scroll
        size_hint_y: 0.4
        
        BoxLayout:
            id: mixing_formula_list
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: 5