#:kivy 2.1.0

BoxLayout:
    orientation: 'horizontal'
    
    # Menu điều hướng bên trái
    BoxLayout:
        orientation: 'vertical'
        size_hint_x: 0.2
        padding: 10
        spacing: 10
        canvas.before:
            Color:
                rgba: 0.15, 0.15, 0.2, 1
            Rectangle:
                pos: self.pos
                size: self.size
        
        # Logo/Title
        Label:
            text: 'HỆ THỐNG\nPHA MÀU'
            font_size: '18sp'
            bold: True
            size_hint_y: 0.15
            color: 1, 1, 1, 1
        
        # Navigation buttons
        Button:
            text: 'Pha màu theo\ncông thức'
            font_size: '14sp'
            size_hint_y: None
            height: 80
            on_press: app.root.ids.screen_manager.current = 'mix_formula_screen'
            background_color: 0.2, 0.6, 0.8, 1
        
        Button:
            text: 'Chiết màu\nbằng tay'
            font_size: '14sp'
            size_hint_y: None
            height: 80
            on_press: app.root.ids.screen_manager.current = 'manual_dispense_screen'
            background_color: 0.2, 0.6, 0.8, 1
        
        Button:
            text: 'Pha màu\ntheo mẫu'
            font_size: '14sp'
            size_hint_y: None
            height: 80
            on_press: app.root.ids.screen_manager.current = 'scan_color_screen'
            background_color: 0.2, 0.6, 0.8, 1
        
        Button:
            text: 'Quản lý màu'
            font_size: '14sp'
            size_hint_y: None
            height: 80
            on_press: app.root.ids.screen_manager.current = 'colorant_manager_screen'
            background_color: 0.3, 0.7, 0.4, 1
        
        Button:
            text: 'Bảo trì'
            font_size: '14sp'
            size_hint_y: None
            height: 80
            on_press: app.root.ids.screen_manager.current = 'maintenance_screen'
            background_color: 0.9, 0.6, 0.2, 1
        
        Button:
            text: 'Hiệu chuẩn'
            font_size: '14sp'
            size_hint_y: None
            height: 80
            on_press: app.root.ids.screen_manager.current = 'calibration_screen'
            background_color: 0.8, 0.3, 0.3, 1
        
        Widget:
            size_hint_y: 1
    
    # Khu vực màn hình chính
    ScreenManager:
        id: screen_manager
        size_hint_x: 0.8
        canvas.before:
            Color:
                rgba: 0.95, 0.95, 0.95, 1
            Rectangle:
                pos: self.pos
                size: self.size
        
        MixByFormulaScreen:
            name: 'mix_formula_screen'
        
        ManualDispenseScreen:
            name: 'manual_dispense_screen'
        
        ScanColorScreen:
            name: 'scan_color_screen'
        
        ColorantManagerScreen:
            name: 'colorant_manager_screen'
        
        MaintenanceScreen:
            name: 'maintenance_screen'
        
        CalibrationScreen:
            name: 'calibration_screen'
