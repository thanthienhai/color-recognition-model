#:kivy 2.1.0

<SavedColorWidget>:
    orientation: 'vertical'
    size_hint: None, None
    size: 180, 240
    padding: 8
    spacing: 5
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12,]
        Color:
            rgba: 0.9, 0.9, 0.9, 1
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 12)
            width: 1.5
    
    # Color preview box
    Widget:
        size_hint_y: 0.35
        canvas:
            Color:
                rgba: root.color_rgb[0]/255.0, root.color_rgb[1]/255.0, root.color_rgb[2]/255.0, 1
            RoundedRectangle:
                pos: self.x + 5, self.y + 5
                size: self.width - 10, self.height - 10
                radius: [8,]
    
    # Color name
    Label:
        text: root.color_name
        font_size: '15sp'
        bold: True
        size_hint_y: 0.15
        color: 0.1, 0.1, 0.1, 1
        text_size: self.size
        halign: 'center'
        valign: 'middle'
    
    # Hex code
    Label:
        text: root.hex_code
        font_size: '12sp'
        size_hint_y: 0.1
        color: 0.4, 0.4, 0.4, 1
    
    # Dominant color and confidence
    Label:
        text: '{} ({:.0f}%)'.format(root.dominant_color, root.confidence * 100)
        font_size: '11sp'
        size_hint_y: 0.1
        color: 0.3, 0.5, 0.7, 1
    
    # Description
    Label:
        text: root.description
        font_size: '10sp'
        size_hint_y: 0.15
        color: 0.5, 0.5, 0.5, 1
        text_size: self.size
        halign: 'center'
        valign: 'top'
    
    # Mix button
    Button:
        text: 'Pha Màu Này'
        size_hint_y: 0.15
        background_color: 0.2, 0.6, 0.9, 1
        on_press: root.on_mix_pressed()

<ColorantStatusWidget>:
    orientation: 'vertical'
    size_hint: None, None
    size: 120, 200
    padding: 5
    spacing: 5
    canvas.before:
        Color:
            rgba: 0.9, 0.9, 0.9, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10,]
    
    # Tên màu
    Label:
        text: root.colorant_name
        font_size: '16sp'
        bold: True
        size_hint_y: 0.2
        color: 0, 0, 0, 1
    
    # Thanh tiến trình
    BoxLayout:
        orientation: 'vertical'
        size_hint_y: 0.6
        padding: 10
        
        Widget:
            size_hint_y: 1
            canvas:
                Color:
                    rgba: 0.3, 0.3, 0.3, 0.3
                Rectangle:
                    pos: self.center_x - 20, self.y
                    size: 40, self.height
                Color:
                    rgba: (0.2 if root.level_percent > 30 else (0.9 if root.level_percent > 10 else 0.9)), (0.7 if root.level_percent > 30 else (0.7 if root.level_percent > 10 else 0.3)), (0.3 if root.level_percent > 30 else (0.2 if root.level_percent > 10 else 0.3)), 1
                Rectangle:
                    pos: self.center_x - 20, self.y
                    size: 40, self.height * (root.level_percent / 100.0)
    
    # Phần trăm
    Label:
        text: '{}%'.format(int(root.level_percent))
        font_size: '14sp'
        size_hint_y: 0.1
        color: 0, 0, 0, 1
    
    # Lượng ml
    Label:
        text: '{} ml'.format(int(root.level_ml))
        font_size: '12sp'
        size_hint_y: 0.1
        color: 0.3, 0.3, 0.3, 1

<ColorantManagerScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 10
        
        # Tiêu đề
        Label:
            text: 'QUẢN LÝ MÀU ĐÃ LƯU'
            font_size: '24sp'
            bold: True
            size_hint_y: 0.08
            color: 0.2, 0.2, 0.2, 1
        
        # Control buttons
        BoxLayout:
            size_hint_y: 0.08
            spacing: 10
            
            Button:
                text: 'Làm mới'
                background_color: 0.3, 0.6, 0.9, 1
                on_press: root.refresh_saved_colors()
            
            TextInput:
                id: search_input
                hint_text: 'Tìm kiếm màu...'
                multiline: False
                size_hint_x: 2
                on_text: root.search_colors(self.text)
            
            Button:
                text: 'Xóa bộ lọc'
                background_color: 0.6, 0.6, 0.6, 1
                on_press: root.clear_search()
        
        # Saved colors grid
        Label:
            text: 'Màu đã lưu ({}):'.format(root.total_colors)
            font_size: '16sp'
            size_hint_y: 0.05
            halign: 'left'
            color: 0.3, 0.3, 0.3, 1
        
        ScrollView:
            size_hint_y: 0.79
            
            GridLayout:
                id: saved_colors_grid
                cols: 3
                size_hint_y: None
                height: self.minimum_height
                spacing: 15
                padding: 10
                row_default_height: 260
                
                # Saved colors will be added dynamically
