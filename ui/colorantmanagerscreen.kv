                    level_percent: 95
                    level_ml: 950
                
                ColorantStatusWidget:
                    colorant_name: 'N'
                    level_percent: 40
                    level_ml: 400
                
                ColorantStatusWidget:
                    colorant_name: 'M'
                    level_percent: 60
