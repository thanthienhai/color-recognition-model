#:kivy 2.1.0

<ScanColorScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 15
        spacing: 10
        canvas.before:
            Color:
                rgba: 0.96, 0.97, 0.98, 1
            Rectangle:
                pos: self.pos
                size: self.size
        
        # Tiêu đề
        Label:
            text: 'PHÁ MÀU THEO MẪU'
            font_size: '22sp'
            bold: True
            size_hint_y: 0.08
            color: 0.15, 0.35, 0.55, 1
        
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: 0.92
            spacing: 15
            
            # Bên trái - Điều khiển và hiển thị màu
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.48
                spacing: 10
                
                # Camera selection card
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: 50
                    spacing: 8
                    padding: [5, 5, 5, 5]
                    canvas.before:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [8,]
                    
                    Spinner:
                        id: camera_spinner
                        text: 'Chọn Camera'
                        values: []
                        size_hint_x: 0.75
                        font_size: '14sp'
                        on_text: root.start_camera_preview()
                        
                    Button:
                        text: 'Tìm'
                        size_hint_x: 0.25
                        font_size: '14sp'
                        background_color: 0.3, 0.5, 0.7, 1
                        on_press: app.find_cameras()

                # Camera control buttons
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: 45
                    spacing: 6
                    
                    Button:
                        text: 'Xem trước'
                        font_size: '13sp'
                        bold: True
                        background_color: 0.25, 0.55, 0.85, 1
                        on_press: root.start_camera_preview()
                    
                    Button:
                        text: 'Dừng'
                        font_size: '13sp'
                        bold: True
                        background_color: 0.75, 0.35, 0.35, 1
                        on_press: root.stop_camera_preview()
                        
                    Button:
                        text: 'Test AI'
                        font_size: '13sp'
                        bold: True
                        background_color: 0.85, 0.55, 0.25, 1
                        on_press: root.test_ai_color_analysis()
                
                # Main scan button
                Button:
                    text: '🎨 ĐO MÀU (AI)'
                    font_size: '18sp'
                    bold: True
                    size_hint_y: None
                    height: 55
                    background_color: 0.2, 0.75, 0.4, 1
                    canvas.before:
                        Color:
                            rgba: 0.2, 0.75, 0.4, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10,]
                    on_press: root.capture_and_analyze()
                
                # Camera preview and color display
                BoxLayout:
                    orientation: 'vertical'
                    spacing: 8
                    
                    Label:
                        text: 'Xem trước / Màu đo'
                        font_size: '15sp'
                        bold: True
                        size_hint_y: None
                        height: 30
                        color: 0.2, 0.2, 0.2, 1
                    
                    BoxLayout:
                        orientation: 'horizontal'
                        spacing: 10
                        
                        # Camera preview
                        BoxLayout:
                            size_hint_x: 0.62
                            canvas.before:
                                Color:
                                    rgba: 0.15, 0.15, 0.15, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [12,]
                            padding: 3
                            
                            Image:
                                id: camera_preview
                                allow_stretch: True
                                keep_ratio: True
                        
                        # Color preview
                        BoxLayout:
                            size_hint_x: 0.38
                            canvas.before:
                                Color:
                                    rgba: 1, 1, 1, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [12,]
                            padding: 8
                            
                            Widget:
                                id: scanned_color_preview
                                canvas:
                                    Color:
                                        rgba: root.scanned_color[0], root.scanned_color[1], root.scanned_color[2], 1
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [8,]
                                    Color:
                                        rgba: 0.8, 0.8, 0.8, 1
                                    Line:
                                        rounded_rectangle: [self.x, self.y, self.width, self.height, 8]
                                        width: 1.5
                
                # Lab values card
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: 110
                    spacing: 8
                    canvas.before:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10,]
                    padding: 12
                    
                    Label:
                        text: 'Giá trị L*a*b*'
                        font_size: '14sp'
                        bold: True
                        size_hint_y: None
                        height: 25
                        color: 0.3, 0.3, 0.3, 1
                    
                    Label:
                        id: lab_value_label
                        text: 'L*: {:.2f}  |  a*: {:.2f}  |  b*: {:.2f}'.format(root.lab_values[0], root.lab_values[1], root.lab_values[2])
                        font_size: '15sp'
                        bold: True
                        size_hint_y: None
                        height: 30
                        color: 0.15, 0.35, 0.55, 1
                    
                    Button:
                        text: '📊 Tính công thức'
                        size_hint_y: None
                        height: 38
                        font_size: '14sp'
                        bold: True
                        background_color: 0.85, 0.65, 0.25, 1
                        on_press: root.calculate_formula()
            
            # Bên phải - Hiển thị công thức
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.52
                spacing: 10
                
                Label:
                    text: 'KẾT QUẢ PHÂN TÍCH'
                    font_size: '16sp'
                    bold: True
                    size_hint_y: None
                    height: 35
                    color: 0.15, 0.35, 0.55, 1
                
                # Product info card
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: 110
                    spacing: 8
                    padding: 12
                    canvas.before:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10,]
                    
                    # Tên sản phẩm
                    BoxLayout:
                        size_hint_y: None
                        height: 45
                        spacing: 8
                        
                        Label:
                            text: 'Tên SP:'
                            color: 0.3, 0.3, 0.3, 1
                            font_size: '13sp'
                            size_hint_x: 0.25
                            halign: 'right'
                        
                        TextInput:
                            id: product_name_input
                            hint_text: 'Nhập tên...'
                            multiline: False
                            size_hint_x: 0.75
                            font_size: '13sp'
                            padding: [10, 10, 10, 10]
                    
                    # Thể tích
                    BoxLayout:
                        size_hint_y: None
                        height: 45
                        spacing: 8
                        
                        Label:
                            text: 'Thể tích:'
                            color: 0.3, 0.3, 0.3, 1
                            font_size: '13sp'
                            size_hint_x: 0.25
                            halign: 'right'
                        
                        Spinner:
                            id: volume_spinner
                            text: '1 Lít'
                            values: ['0.5L', '1L', '2.5L', '5L', '10L']
                            size_hint_x: 0.75
                            font_size: '13sp'
                
                # Formula display card
                BoxLayout:
                    orientation: 'vertical'
                    spacing: 8
                    canvas.before:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10,]
                    padding: 12
                    
                    Label:
                        text: 'Công thức pha'
                        font_size: '14sp'
                        bold: True
                        size_hint_y: None
                        height: 30
                        color: 0.3, 0.3, 0.3, 1
                    
                    ScrollView:
                        BoxLayout:
                            id: result_formula_display
                            orientation: 'vertical'
                            size_hint_y: None
                            height: self.minimum_height
                            padding: [5, 5, 5, 5]
                            spacing: 5
                            
                            Label:
                                text: 'Nhấn "Đo màu (AI)" để phân tích'
                                color: 0.6, 0.6, 0.6, 1
                                font_size: '13sp'
                                size_hint_y: None
                                height: 40
                
                # Delta E info
                BoxLayout:
                    size_hint_y: None
                    height: 45
                    padding: 10
                    canvas.before:
                        Color:
                            rgba: 0.95, 0.98, 0.95, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [8,]
                    
                    Label:
                        id: delta_e_label
                        text: 'ΔE: -'
                        font_size: '14sp'
                        bold: True
                        color: 0.2, 0.5, 0.2, 1
                
                # Action buttons
                BoxLayout:
                    orientation: 'horizontal'
                    spacing: 10
                    size_hint_y: None
                    height: 55
                    
                    Button:
                        text: '💾 LƯU MÀU'
                        font_size: '16sp'
                        bold: True
                        background_color: 0.3, 0.6, 0.9, 1
                        canvas.before:
                            Color:
                                rgba: 0.3, 0.6, 0.9, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [10,]
                        on_press: root.save_current_color()
                    
                    Button:
                        text: '✓ PHA MÀU NÀY'
                        font_size: '16sp'
                        bold: True
                        background_color: 0.25, 0.7, 0.35, 1
                        canvas.before:
                            Color:
                                rgba: 0.25, 0.7, 0.35, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [10,]
                        on_press: root.start_mixing()
